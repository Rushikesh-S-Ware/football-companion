# --- Secrets & config ---
# Never commit the real API key. Only .env.example (a blank template) is tracked.
.env

# --- Data snapshots ---
# The DuckDB file can get large and is regenerated by running the snapshot command,
# so we keep it out of git. The data/ folder itself is kept via data/.gitkeep.
data/*.duckdb
data/*.duckdb.wal

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# --- Editor / OS noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db
