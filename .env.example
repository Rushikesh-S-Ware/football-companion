# Copy this file to ".env" and fill in your real keys.
# .env is gitignored so your secrets never get committed.
# All three are free to obtain.

# 1) Groq API key — Leo's brain (fast Llama inference, free tier).
#    Get it free at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# 2) football-data.org token — fixtures, results, standings (La Liga + UCL).
#    Register free at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=your-football-data-token-here

# 3) API-Football key — lineups, formations, injuries, match stats.
#    Free plan (100 requests/day) at: https://www.api-football.com
API_FOOTBALL_KEY=your-api-football-key-here
