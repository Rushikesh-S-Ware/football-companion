# Copy this file to ".env" and fill in your real key.
# .env is gitignored so your secret never gets committed.
#
# This key is for the Anthropic API (console.anthropic.com) — it is what the
# FPL AGENT (the program) uses to call Claude. It is SEPARATE from the Claude
# subscription that powers Claude Code (the builder).
ANTHROPIC_API_KEY=your-key-here
